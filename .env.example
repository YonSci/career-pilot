APP_TOKEN=
POSTGRES_PASSWORD=
DATABASE_URL=sqlite:///./data/career.db
DATA_DIR=data
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000
OPENAI_API_KEY=
EXTRACT_MODEL=gpt-5.6-luna
MATCH_MODEL=gpt-5.6-terra
WRITE_MODEL=gpt-5.6-sol
REDIS_URL=redis://redis:6379/0
TASK_QUEUE=background
# In-process scheduler and Telegram polling for the local (non-Celery) mode.
SCHEDULER_ENABLED=true
MAX_PAGE_FETCHES_PER_RUN=60
FETCH_DELAY_SECONDS=1
ARCHIVE_AFTER_DAYS=45
DASHBOARD_DIR=dashboard
TELEGRAM_BOT_TOKEN=
# Optional: leave empty and link your chat from the dashboard instead.
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=label:CareerPilot newer_than:7d
# Request at https://apidoc.reliefweb.int/parameters#appname. Empty = RSS fallback.
RELIEFWEB_APPNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=
WHATSAPP_TO=
WHATSAPP_CONTENT_SID=
# Hosted dashboard proxy only. Configure these through Sites environment settings.
CAREER_API_URL=
CAREER_API_TOKEN=
CAREER_OWNER_EMAIL=
